# Copy to `.env` and edit. Every value here is optional.
#
# VITE_* is BAKED INTO THE BUNDLE and downloaded by every visitor. Never put a
# credential in one. Keys belong in Settings (kept in the browser's
# localStorage) or in the GOMOKU_*_KEY variables below, which stay on the
# server.

# --- Client defaults (public) ---------------------------------------------

# Any endpoint speaking the Jev wire API: POST <base>/systemone
# TypeSafe: https://api.typesafe.ai/v1
# localjev: http://127.0.0.1:8080/v1
# openjev:  http://127.0.0.1:8000/v1
VITE_JEV_BASE_URL=https://api.typesafe.ai/v1
VITE_JEV_MODEL=jev-latest

# Any endpoint speaking the OpenAI chat API: POST <base>/chat/completions
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# How a fresh game starts. free|renju and pvp|pvc|cvc.
VITE_DEFAULT_RULE_SET=free
VITE_DEFAULT_MATCH=pvc

# Give the on-device model the default AI seat when the browser has one.
VITE_PREFER_BROWSER_MODEL=true

# How many moves an engine chooses between (2-24). More candidates cost tokens.
VITE_CANDIDATE_LIMIT=8

# A beat before an engine moves, so a fast reply is still readable (0-5000 ms).
VITE_AI_MOVE_DELAY_MS=260

# Where browser-held settings are stored.
VITE_STORAGE_KEY=gomoku.settings

# --- Server (never reaches the browser) -----------------------------------

# For `npm start`.
PORT=5273
HOST=127.0.0.1

# Fallback keys used by the relay when the page sends none. Setting these lets
# you play without typing a key, at the cost of every visitor to this server
# being able to spend them.
# GOMOKU_JEV_KEY=
# GOMOKU_OPENAI_KEY=

# How long the relay waits for an upstream answer.
GOMOKU_UPSTREAM_TIMEOUT_MS=60000

# Allow plain http to a non-loopback endpoint. Off by default: it sends your
# key over the network in the clear.
GOMOKU_ALLOW_INSECURE_HTTP=false

# Required alongside a GOMOKU_*_KEY. A server key is spent on the caller's
# behalf, so the destination must be chosen here rather than by the page.
# GOMOKU_JEV_BASE_URL=https://api.typesafe.ai/v1
# GOMOKU_OPENAI_BASE_URL=https://api.openai.com/v1
